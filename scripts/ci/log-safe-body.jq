if type == "object" then [to_entries[] | .key as $k | .value as $v | ($v | type) as $t | "\($k)=" + (if $t == "array" then "\($v | length) items" elif $t == "object" then "{\($v | length) keys}" elif $t == "boolean" or $t == "null" then ($v | tostring) elif $t == "number" and ($k | test("count|processed|skipped|failed|sent|created|updated|deleted|scanned|checked|posted|rebuilt|attempted|replayed|remaining|pending|errors|ms$|^n[A-Z_]"; "i")) and (($k | test("Rm$|Sen$|_rm$|_sen$")) or ($k | test("amount|price|cost|value|balance|total"; "i")) | not) then ($v | tostring) else "<\($t)>" end)] | join(" ") elif type == "array" then "[\(length) items]" else "<\(type)>" end
